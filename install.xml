<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>УниКредит покупки на Кредит</name>
    <code>mt_uni_credit</code>
    <version>2.0.2</version>
    <author>Авалон ООД</author>
    <link>https://avalonbg.com</link>

    <!-- Product controller: inject widget HTML via module controller (business logic stays in module). -->
    <file path="catalog/controller/product/product.php">
        <operation>
            <search><![CDATA[$data['products'] = array();]]></search>
            <add position="after"><![CDATA[
        // mt_uni_credit:product
        $data['mt_uni_credit_product_widget'] = $this->load->controller('extension/mt_uni_credit/product/widget');
            ]]></add>
        </operation>
    </file>

    <!--
      Product template: frozen anchor `{% if minimum > 1 %}` (before).
      Product injection is mandatory → error="abort" (do not silently skip).
      Widget may sit inside #form-product; JS moves the dialog to document.body.
    -->
    <file path="catalog/view/theme/*/template/product/product.twig" error="abort">
        <operation>
            <search><![CDATA[
{% if minimum > 1 %}
        ]]></search>
            <add position="before"><![CDATA[
            <!-- mt_uni_credit:product -->
            {{ mt_uni_credit_product_widget }}
            <!-- /mt_uni_credit:product -->
        ]]></add>
        </operation>
    </file>

    <!-- Cart controller -->
    <file path="catalog/controller/checkout/cart.php">
        <operation>
            <search><![CDATA[$this->document->setTitle($this->language->get('heading_title'));]]></search>
            <add position="after"><![CDATA[
        // mt_uni_credit:cart
        $data['mt_uni_credit_cart_widget'] = $this->load->controller('extension/mt_uni_credit/cart/widget');
            ]]></add>
        </operation>
    </file>

    <!-- Cart template -->
    <file path="catalog/view/theme/*/template/checkout/cart.twig" error="skip">
        <operation>
            <search><![CDATA[{{ content_bottom }}</div>]]></search>
            <add position="before"><![CDATA[
      <!-- mt_uni_credit:cart -->
      {{ mt_uni_credit_cart_widget }}
      <!-- /mt_uni_credit:cart -->
]]></add>
        </operation>
    </file>

    <!--
      Product Buy → Checkout: native payment_method preselect when Buy preference is valid.
      Thin OCMOD → module controller (OCMOD-001). Session + $data['code'] stay in sync.
    -->
    <file path="catalog/controller/checkout/payment_method.php">
        <operation>
            <search><![CDATA[$this->session->data['payment_methods'] = $method_data;]]></search>
            <add position="after"><![CDATA[
			// mt_uni_credit:product_buy_payment_preselect
			$this->load->controller('extension/mt_uni_credit/product_buy/applyPaymentPreselect');
            ]]></add>
        </operation>
        <operation>
            <search><![CDATA[$this->session->data['payment_method'] = $this->session->data['payment_methods'][$this->request->post['payment_method']];]]></search>
            <add position="after"><![CDATA[
			// mt_uni_credit:product_buy_payment_clear
			$this->load->controller('extension/mt_uni_credit/product_buy/onPaymentMethodSaved');
            ]]></add>
        </operation>
    </file>
</modification>
