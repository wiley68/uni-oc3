{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <fieldset>
            <legend>{{ text_module_identity }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ text_module_identity }}</label>
              <div class="col-sm-10">
                <p class="form-control-static">{{ module_code }} v{{ module_version }}</p>
              </div>
            </div>
          </fieldset>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_mt_uni_credit_status" id="input-status" class="form-control">
                {% if payment_mt_uni_credit_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ help_status }}</p>
            </div>
          </div>
          <div class="form-group{% if error_sort_order %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_mt_uni_credit_sort_order" value="{{ payment_mt_uni_credit_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
              {% if error_sort_order %}<div class="text-danger">{{ error_sort_order }}</div>{% endif %}
              <p class="help-block">{{ help_sort_order }}</p>
            </div>
          </div>
          <div class="form-group{% if error_environment %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-environment">{{ entry_environment }}</label>
            <div class="col-sm-10">
              <select name="payment_mt_uni_credit_environment" id="input-environment" class="form-control">
                {% if payment_mt_uni_credit_environment == '1' %}
                <option value="0">{{ text_environment_test }}</option>
                <option value="1" selected="selected">{{ text_environment_production }}</option>
                {% else %}
                <option value="0" selected="selected">{{ text_environment_test }}</option>
                <option value="1">{{ text_environment_production }}</option>
                {% endif %}
              </select>
              {% if error_environment %}<div class="text-danger">{{ error_environment }}</div>{% endif %}
              <p class="help-block">{{ help_environment }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
            <div class="col-sm-10">
              <select name="payment_mt_uni_credit_debug" id="input-debug" class="form-control">
                {% if payment_mt_uni_credit_debug %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ help_debug }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-unicid">{{ entry_unicid }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_mt_uni_credit_unicid" value="{{ payment_mt_uni_credit_unicid }}" placeholder="{{ entry_unicid }}" id="input-unicid" class="form-control" autocomplete="off" />
              <p class="help-block">{{ help_unicid }}</p>
            </div>
          </div>
          <div class="form-group{% if error_secret %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-secret">{{ entry_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_mt_uni_credit_secret" value="" placeholder="{{ entry_secret }}" id="input-secret" class="form-control" autocomplete="new-password" />
              {% if error_secret %}<div class="text-danger">{{ error_secret }}</div>{% endif %}
              <p class="help-block">{{ help_secret }}</p>
              <p class="help-block">{{ text_secret_phase2 }}</p>
              {% if has_secret %}
              <p class="help-block text-muted">{{ text_secret_keep_current }}</p>
              {% endif %}
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-heartbeat"></i> {{ text_health }}</h3>
      </div>
      <div class="panel-body">
        <div class="alert alert-info">
          <strong>{{ health_summary.status|upper }}</strong>: {{ health_summary.detail }}
        </div>
        <p>{{ text_deployment_paths }}:</p>
        <ul class="list-unstyled">
          <li><code>{{ health_paths.passphrase }}</code></li>
          <li><code>{{ health_paths.certificate }}</code></li>
          <li><code>{{ health_paths.private_key }}</code></li>
        </ul>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td>{{ column_check }}</td>
                <td>{{ column_status }}</td>
                <td>{{ column_detail }}</td>
              </tr>
            </thead>
            <tbody>
              {% for check in health_checks %}
              <tr>
                <td>{{ check.id }}</td>
                <td>{{ health_status_labels[check.status] }}</td>
                <td>{{ check.detail }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
