{{ header }}{{ column_left }}
{#
  OC3 admin common.js submits every form[id*="form-"] on any submit-button click.
  Keep only #form-module persistent; operational actions POST via temporary forms.
#}
<div id="content" class="mt-uni-credit-module" data-mt-uni-credit-refresh-bank="{{ refresh_bank_data }}" data-mt-uni-credit-download-journal="{{ download_journal }}">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <input type="hidden" name="module_mt_uni_credit_status" value="0" />
              <label class="mt-uni-toggle" for="input-status">
                <input type="checkbox" name="module_mt_uni_credit_status" value="1" id="input-status" class="mt-uni-toggle__input"{% if module_mt_uni_credit_status %} checked="checked"{% endif %} />
                <span class="mt-uni-toggle__track" aria-hidden="true"></span>
              </label>
            </div>
          </div>
          <div class="form-group{% if error_unicid %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-unicid">{{ entry_unicid }} <span class="mt-uni-required" aria-hidden="true">*</span></label>
            <div class="col-sm-10">
              <input type="text" name="module_mt_uni_credit_unicid" value="{{ module_mt_uni_credit_unicid }}" placeholder="{{ entry_unicid }}" id="input-unicid" class="form-control" maxlength="36" required="required" autocomplete="off" />
              {% if error_unicid %}<div class="text-danger">{{ error_unicid }}</div>{% endif %}
              <p class="help-block">{{ help_unicid }}</p>
            </div>
          </div>
          <div class="form-group{% if error_secret %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-secret">{{ entry_secret }}{% if not has_secret %} <span class="mt-uni-required" aria-hidden="true">*</span>{% endif %}</label>
            <div class="col-sm-10">
              <input type="password" name="module_mt_uni_credit_secret" value="" placeholder="{{ entry_secret }}" id="input-secret" class="form-control" maxlength="64" autocomplete="new-password"{% if not has_secret %} required="required"{% endif %} />
              {% if error_secret %}<div class="text-danger">{{ error_secret }}</div>{% endif %}
              <p class="help-block">{{ help_secret }}{% if has_secret %} {{ text_secret_keep_current }} {{ text_secret_configured }}{% endif %}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-advertising">{{ entry_advertising_enabled }}</label>
            <div class="col-sm-10">
              <input type="hidden" name="module_mt_uni_credit_advertising_enabled" value="0" />
              <label class="mt-uni-toggle" for="input-advertising">
                <input type="checkbox" name="module_mt_uni_credit_advertising_enabled" value="1" id="input-advertising" class="mt-uni-toggle__input"{% if module_mt_uni_credit_advertising_enabled %} checked="checked"{% endif %} />
                <span class="mt-uni-toggle__track" aria-hidden="true"></span>
              </label>
              <p class="help-block">{{ help_advertising_enabled }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug_enabled }}</label>
            <div class="col-sm-10">
              <input type="hidden" name="module_mt_uni_credit_debug_enabled" value="0" />
              <label class="mt-uni-toggle" for="input-debug">
                <input type="checkbox" name="module_mt_uni_credit_debug_enabled" value="1" id="input-debug" class="mt-uni-toggle__input"{% if module_mt_uni_credit_debug_enabled %} checked="checked"{% endif %} />
                <span class="mt-uni-toggle__track" aria-hidden="true"></span>
              </label>
              <p class="help-block">{{ help_debug_enabled }}</p>
            </div>
          </div>
          <div class="form-group{% if error_product_button_action %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-product-button-action">{{ entry_product_button_action }}</label>
            <div class="col-sm-10">
              <select name="module_mt_uni_credit_product_button_action" id="input-product-button-action" class="form-control">
                {% for action in product_button_actions %}
                <option value="{{ action.value }}"{% if module_mt_uni_credit_product_button_action == action.value %} selected="selected"{% endif %}>{{ action.label }}</option>
                {% endfor %}
              </select>
              {% if error_product_button_action %}<div class="text-danger">{{ error_product_button_action }}</div>{% endif %}
              <p class="help-block">{{ help_product_button_action }}</p>
            </div>
          </div>
          <div class="form-group{% if error_button_top_spacing %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-button-top-spacing">{{ entry_button_top_spacing }}</label>
            <div class="col-sm-10">
              <input type="number" name="module_mt_uni_credit_button_top_spacing" value="{{ module_mt_uni_credit_button_top_spacing }}" min="0" max="200" step="1" id="input-button-top-spacing" class="form-control" style="max-width:8rem;" />
              {% if error_button_top_spacing %}<div class="text-danger">{{ error_button_top_spacing }}</div>{% endif %}
              <p class="help-block">{{ help_button_top_spacing }}</p>
            </div>
          </div>
        </form>
        <div class="form-horizontal">
          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <button type="button" id="button-mt-uni-credit-refresh-bank" class="btn btn-default mt-uni-inline-action">
                <i class="fa fa-refresh"></i> {{ button_refresh_bank_data }}
              </button>
              <button type="button" id="button-mt-uni-credit-download-journal" class="btn btn-default mt-uni-inline-action">
                <i class="fa fa-download"></i> {{ button_download_journal }}
              </button>
              <p class="help-block">{{ help_download_journal }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
