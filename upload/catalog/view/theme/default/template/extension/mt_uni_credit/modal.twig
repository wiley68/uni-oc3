{% set modal_id = entry_point == 'cart' ? 'mt-uni-credit-cart-modal' : 'mt-uni-credit-product-modal' %}
{% set form_id = entry_point == 'cart' ? 'mt-uni-credit-cart-form' : 'mt-uni-credit-product-form' %}
{% set modal_meta = modal_meta is defined ? modal_meta : {} %}
{% set customer = modal_meta.customer is defined ? modal_meta.customer : (customer is defined ? customer : {}) %}
{% set process2 = modal_meta.process2 is defined ? modal_meta.process2 : false %}
{% set consents = modal_meta.consents is defined ? modal_meta.consents : [] %}
{% set field_suffix = entry_point ~ '-' ~ (product_id is defined ? product_id : 'cart') %}
<div id="{{ modal_id }}"
     class="mt-uni-credit-storefront__modal"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     hidden>
  <div class="mt-uni-credit-storefront__overlay" data-mtuc-dismiss aria-hidden="true"></div>
  <div class="mt-uni-credit-storefront__modal-scroll">
    <div class="mt-uni-credit-storefront__dialog" tabindex="-1">
      {% if modal_meta.banner_url or modal_meta.banner_url_mobile %}
        <div class="mt-uni-credit-storefront__banner">
          {% if modal_meta.banner_link %}<a href="{{ modal_meta.banner_link }}" target="_blank" rel="noopener noreferrer">{% endif %}
            <picture>
              {% if modal_meta.banner_url_mobile %}
                <source media="(max-width: 768px)" srcset="{{ modal_meta.banner_url_mobile }}">
              {% endif %}
              <img src="{{ modal_meta.banner_url ? modal_meta.banner_url : modal_meta.banner_url_mobile }}" alt="UniCredit">
            </picture>
          {% if modal_meta.banner_link %}</a>{% endif %}
        </div>
      {% endif %}

      <div class="mt-uni-credit-storefront__popup-panel">
        <div class="mt-uni-credit-storefront__step mt-uni-credit-storefront__step--active" data-mtuc-step="1">
          <h2 class="mt-uni-credit-storefront__popup-title">{{ text_modal_title_scheme }}</h2>
          <div class="mt-uni-credit-storefront__popup-calc">
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_price }}</div>
              <div class="mt-uni-credit-storefront__popup-value" data-mtuc-display="price"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <label class="mt-uni-credit-storefront__popup-label" for="mtuc-months-{{ entry_point }}-{{ product_id }}">{{ text_months }}</label>
              <div class="mt-uni-credit-storefront__popup-value">
                <select id="mtuc-months-{{ entry_point }}-{{ product_id }}" class="mt-uni-credit-storefront__popup-select" data-mtuc-schemes></select>
              </div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row" data-mtuc-first-row{% if not calculator.show_first_installment %} hidden{% endif %}>
              <label class="mt-uni-credit-storefront__popup-label" for="mtuc-first-{{ entry_point }}-{{ product_id }}">{{ text_first_installment }}</label>
              <div class="mt-uni-credit-storefront__popup-value">
                <input id="mtuc-first-{{ entry_point }}-{{ product_id }}" class="mt-uni-credit-storefront__popup-input" data-mtuc-first type="text" inputmode="numeric" pattern="[0-9]*" value="0">
              </div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_financed_amount }}</div>
              <div class="mt-uni-credit-storefront__popup-value" data-mtuc-display="financed_amount"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_monthly_installment }}</div>
              <div class="mt-uni-credit-storefront__popup-value" data-mtuc-display="monthly_installment"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_total_payable }}</div>
              <div class="mt-uni-credit-storefront__popup-value" data-mtuc-display="total_payable"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_glp }}</div>
              <div class="mt-uni-credit-storefront__popup-value mt-uni-credit-storefront__popup-value--red" data-mtuc-display="glp"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row">
              <div class="mt-uni-credit-storefront__popup-label">{{ text_gpr }}</div>
              <div class="mt-uni-credit-storefront__popup-value mt-uni-credit-storefront__popup-value--red" data-mtuc-display="gpr"></div>
            </div>
            <div class="mt-uni-credit-storefront__popup-row mt-uni-credit-storefront__popup-row--note" data-mtuc-popup-error role="alert"></div>
          </div>
          <div class="mt-uni-credit-storefront__popup-actions mt-uni-credit-storefront__popup-actions--step1">
            <div class="mt-uni-credit-storefront__popup-actions-left mt-uni-credit-storefront__popup-actions-group">
              <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--secondary" data-mtuc-dismiss><span><b>{{ text_cancel }}</b></span></button>
              {% if not hide_secondary %}
              <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--secondary" data-mtuc-secondary><span><b>{{ text_secondary }}</b></span></button>
              {% endif %}
            </div>
            <div class="mt-uni-credit-storefront__popup-actions-right">
              <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--primary" data-mtuc-apply>
                <span><b>{{ text_apply }}</b></span>
                <i style="background-image:url('{{ badge_url }}')" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-uni-credit-storefront__step" data-mtuc-step="2" hidden>
          <h2 class="mt-uni-credit-storefront__popup-title">{{ text_modal_title_customer|default(heading) }}</h2>
          <form id="{{ form_id }}" data-mtuc-form data-mtuc-process="{{ process2 ? '2' : '1' }}" novalidate>
            {% if customer.address_id %}
              <input type="hidden" name="address_id" value="{{ customer.address_id }}">
            {% endif %}
            <div class="mt-uni-credit-storefront__customer-form" data-mtuc-customer-form>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-firstname-{{ field_suffix }}">{{ text_firstname }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-firstname-{{ field_suffix }}" name="firstname" type="text" value="{{ customer.firstname }}" required aria-required="true" autocomplete="given-name" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="firstname" role="alert"></span>
              </div>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-lastname-{{ field_suffix }}">{{ text_lastname }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-lastname-{{ field_suffix }}" name="lastname" type="text" value="{{ customer.lastname }}" required aria-required="true" autocomplete="family-name" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="lastname" role="alert"></span>
              </div>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-address-{{ field_suffix }}">{{ text_address }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-address-{{ field_suffix }}" name="address" type="text" value="{{ customer.address }}" required aria-required="true" autocomplete="street-address" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="address" role="alert"></span>
              </div>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-phone-{{ field_suffix }}">{{ text_telephone }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-phone-{{ field_suffix }}" name="phone" type="tel" value="{{ customer.telephone }}" required aria-required="true" autocomplete="tel" inputmode="tel" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="phone" role="alert"></span>
              </div>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-email-{{ field_suffix }}">{{ text_email }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-email-{{ field_suffix }}" name="email" type="email" value="{{ customer.email }}" required aria-required="true" autocomplete="email" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="email" role="alert"></span>
              </div>
              {% if process2 %}
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-phone2-{{ field_suffix }}">{{ text_phone2 }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-phone2-{{ field_suffix }}" name="phone2" type="tel" value="" required aria-required="true" autocomplete="tel" inputmode="tel" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="phone2" role="alert"></span>
              </div>
              <div class="mt-uni-credit-storefront__customer-field">
                <label class="mt-uni-credit-storefront__customer-label" for="mtuc-egn-{{ field_suffix }}">{{ text_egn }} <span class="mt-uni-credit-storefront__required" aria-hidden="true">{{ text_required }}</span></label>
                <input class="mt-uni-credit-storefront__customer-input" id="mtuc-egn-{{ field_suffix }}" name="egn" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="10" value="" required aria-required="true" autocomplete="off" data-mtuc-required="1">
                <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="egn" role="alert"></span>
              </div>
              {% endif %}
              <span class="mt-uni-credit-storefront__field-error" data-mtuc-submit-error role="alert"></span>
            </div>
            {% if consents %}
              <div class="mt-uni-credit-storefront__consents" data-mtuc-consents aria-label="{{ text_consents }}">
                {% for consent in consents %}
                  <div class="mt-uni-credit-storefront__consent{% if not consent.has_checkbox %} mt-uni-credit-storefront__consent--info{% endif %}">
                    {% if consent.has_checkbox %}
                      <input type="checkbox" class="mt-uni-credit-storefront__consent-checkbox" id="mtuc-consent-{{ field_suffix }}-{{ consent.id }}" name="consent[]" value="{{ consent.id }}" data-mtuc-consent-checkbox>
                      <label class="mt-uni-credit-storefront__consent-label" for="mtuc-consent-{{ field_suffix }}-{{ consent.id }}">
                        {% if consent.url %}<a href="{{ consent.url }}" target="_blank" rel="noopener noreferrer">{{ consent.name }}</a>{% else %}{{ consent.name }}{% endif %}
                      </label>
                    {% else %}
                      <p class="mt-uni-credit-storefront__consent-text">
                        {% if consent.url %}<a href="{{ consent.url }}" target="_blank" rel="noopener noreferrer">{{ consent.name }}</a>{% else %}{{ consent.name }}{% endif %}
                      </p>
                    {% endif %}
                    <span class="mt-uni-credit-storefront__field-error" data-mtuc-field-error="consent-{{ consent.id }}" role="alert"></span>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="mt-uni-credit-storefront__consents" data-mtuc-consents>
                <div class="mt-uni-credit-storefront__consent">
                  <input type="checkbox" class="mt-uni-credit-storefront__consent-checkbox" id="mtuc-consent-{{ field_suffix }}" name="consent" value="1" data-mtuc-consent-checkbox data-mtuc-consent>
                  <label class="mt-uni-credit-storefront__consent-label" for="mtuc-consent-{{ field_suffix }}">{{ text_consent }}</label>
                </div>
              </div>
            {% endif %}
            <div class="mt-uni-credit-storefront__popup-actions mt-uni-credit-storefront__popup-actions--step2">
              <div class="mt-uni-credit-storefront__popup-actions-group">
                <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--secondary" data-mtuc-back><span><b>{{ text_back }}</b></span></button>
                <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--secondary" data-mtuc-dismiss><span><b>{{ text_cancel }}</b></span></button>
              </div>
              <button type="button" class="mt-uni-credit-storefront__popup-button mt-uni-credit-storefront__popup-button--primary is-disabled" data-mtuc-submit disabled aria-disabled="true">
                <span><b>{{ text_submit }}</b></span>
                <i style="background-image:url('{{ badge_url }}')" aria-hidden="true"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-uni-credit-storefront__processing" data-mtuc-processing hidden>
    <div class="mt-uni-credit-storefront__processing-panel" role="status" aria-live="polite" aria-busy="true">
      <span class="mt-uni-credit-storefront__processing-spinner" aria-hidden="true"></span>
      <strong>{{ text_processing_title }}</strong>
      <span>{{ text_processing }}</span>
    </div>
  </div>
</div>
