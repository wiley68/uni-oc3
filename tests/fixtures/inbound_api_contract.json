    "403": "module disabled",
    "404": "owned order/log missing",
    "405": "method",
    "409": "order_ambiguous / semantic_conflict (P1↔P2)",
    "413": "payload too large",
    "422": "shop_snapshot_invalid + data.violations",
    "500": "redacted unexpected failure"
  },
  "do_not_use_seo_aliases": true,
  "hmac_fixture": "hmac_callback_vector.json"
