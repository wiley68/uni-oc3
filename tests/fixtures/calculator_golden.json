{
  "source": {
    "oracle_date": "2026-08-17",
    "shop_fixture": "tests/Calculator/fixtures.php",
    "golden_test": "tests/Calculator/GoldenParityVectorsTest.php",
    "domain_test": "tests/Calculator/CalculatorDomainTest.php",
    "cart_test": "tests/Cart/CartSchemeResolverTest.php",
    "presentation_test": "tests/Calculator/V202PresentationParityTest.php",
    "calculator": "src/Calculator/Calculator.php",
    "offer_factory": "src/Calculator/OfferFactory.php"
  },
  "formulas": {
    "monthly_installment": "round(financed * coeff, 2)",
    "total_payable": "round(monthly * months, 2)",
    "glp": "round(abs(interestPercent), 2)",
    "gpr_calculateScheme": "raw <= 0.1 ? 0.0 : round(raw, 2)",
    "gpr_offerFactory": "round(raw, 2)  /* no 0.1 floor */",
    "locked_first_installment": "round(price / months, 2) when filter.uni_parva === 1"
  },
  "shop": {
    "uni_status": 1,
    "uni_minstojnost": 100,
    "uni_maxstojnost": 10000,
    "uni_first_vnoska": 1,
    "uni_shema_current": 12,
    "uni_typekop": 0,
    "uni_eur": 0,
    "uni_meseci_6": 1,
    "uni_meseci_12": 1,
    "uni_meseci_24": 1,
    "kop": {
      "by_default": {
        "uni_kop_default": "STD",
        "uni_kop_default_desc": "",
        "uni_kop_promo": "PROMO",
        "uni_kop_promo_desc": "0% лихва за компютри",
        "uni_promo_price": 500,
        "uni_promo_meseci_znak": "eq",
        "uni_promo_meseci": "12_24"
      },
      "by_schema": {"filters": []}
